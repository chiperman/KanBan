{
  "name": "personal-asset-dashboard",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "native:longbridge:build": "node scripts/build-longbridge-keychain-sdk.mjs",
    "longbridge:keychain:repair": "node scripts/longbridge-keychain.mjs repair",
    "daily-settlement:run": "node --experimental-transform-types --import ./scripts/register-ts-alias.mjs ./scripts/run-formal-daily-settlement.ts",
    "daily-settlement:launchd": "node ./scripts/formal-daily-settlement-launchd.mjs",
    "migrate:json-to-sqlite": "node --experimental-transform-types --import ./scripts/register-ts-alias.mjs ./scripts/migrate-json-to-sqlite.ts",
    "predev": "pnpm native:longbridge:check",
    "prebuild": "pnpm native:longbridge:build",
    "prestart": "pnpm native:longbridge:check",
    "dev": "node scripts/run-local-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-local-next.mjs start",
    "typecheck": "tsc --noEmit",
    "test:browser:build": "pnpm native:longbridge:check && pnpm exec next build",
    "test:browser:test": "pnpm test:browser:build && playwright test",
    "test:browser:production": "pnpm test:browser:build && playwright test --config=playwright.production.config.ts",
    "test:browser": "pnpm test:browser:build && node scripts/run-playwright-shards.mjs && PLAYWRIGHT_CONFIG=playwright.production.config.ts node scripts/run-playwright-shards.mjs",
    "test:browser:serial": "pnpm test:browser:build && playwright test && playwright test --config=playwright.production.config.ts",
    "test:browser:parallel": "pnpm test:browser:build && node scripts/run-playwright-shards.mjs",
    "test:browser:production:parallel": "pnpm test:browser:build && PLAYWRIGHT_CONFIG=playwright.production.config.ts node scripts/run-playwright-shards.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:smoke:quick": "playwright test",
    "test:smoke": "pnpm build && pnpm test:smoke:quick",
    "test:e2e:full": "playwright test --config=playwright.archive.config.ts",
    "test:regression": "pnpm test:browser",
    "test": "pnpm typecheck && pnpm test:unit && pnpm test:smoke",
    "preinstall": "node scripts/check-toolchain.mjs",
    "native:longbridge:check": "node scripts/native-artifact.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "next": "^16.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0"
}
