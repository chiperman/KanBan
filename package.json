{
  "name": "personal-asset-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "native:longbridge:build": "node scripts/build-longbridge-keychain-sdk.mjs",
    "longbridge:keychain:repair": "node scripts/longbridge-keychain.mjs repair",
    "daily-settlement:run": "node --experimental-transform-types --import ./scripts/register-ts-alias.mjs ./scripts/run-formal-daily-settlement.ts",
    "daily-settlement:launchd": "node ./scripts/formal-daily-settlement-launchd.mjs",
    "predev": "pnpm native:longbridge:build",
    "prebuild": "pnpm native:longbridge:build",
    "prestart": "pnpm native:longbridge:build",
    "dev": "node scripts/run-local-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-local-next.mjs start",
    "typecheck": "tsc --noEmit",
    "test:browser:test": "playwright test",
    "test:browser:production": "playwright test --config=playwright.production.config.ts",
    "test:browser": "pnpm test:browser:parallel && pnpm test:browser:production:parallel",
    "test:browser:serial": "pnpm test:browser:test && pnpm test:browser:production",
    "test:browser:parallel": "node scripts/run-playwright-shards.mjs",
    "test:browser:production:parallel": "PLAYWRIGHT_CONFIG=playwright.production.config.ts node scripts/run-playwright-shards.mjs",
    "test:unit": "node --experimental-transform-types --import ./scripts/register-ts-alias.mjs --test scripts/test-command-contract.test.mjs src/domain/daily-trend-observations.test.ts src/domain/investment-performance.test.ts src/domain/investment-performance-trend.test.ts src/domain/reporting-exchange-rates.test.ts src/server/asset-sources/bit.test.ts src/server/investment-cashflows.test.ts src/ui/asset-price-display.test.ts src/ui/asset-product-coverage.test.ts src/ui/card-layout/card-layout-planner.test.ts",
    "test:smoke:quick": "playwright test --config=playwright.smoke.config.ts",
    "test:smoke": "pnpm build && pnpm test:smoke:quick",
    "test:ticket-02:quick": "playwright test --config=playwright.ticket-02.config.ts",
    "test:ticket-02": "pnpm build && pnpm test:ticket-02:quick",
    "test:ticket-03:quick": "playwright test --config=playwright.ticket-03.config.ts",
    "test:ticket-03": "pnpm build && pnpm test:ticket-03:quick",
    "test:ticket-04:quick": "playwright test --config=playwright.ticket-04.config.ts",
    "test:ticket-04": "pnpm build && pnpm test:ticket-04:quick",
    "test:ticket-05:quick": "playwright test --config=playwright.ticket-05.config.ts",
    "test:ticket-05": "pnpm build && pnpm test:ticket-05:quick",
    "test:ticket-06:quick": "playwright test --config=playwright.ticket-06.config.ts",
    "test:ticket-06": "pnpm build && pnpm test:ticket-06:quick",
    "test:ticket-07:quick": "playwright test --config=playwright.ticket-07.config.ts",
    "test:ticket-07": "pnpm build && pnpm test:ticket-07:quick",
    "test:regression": "pnpm build && pnpm test:browser",
    "test": "pnpm typecheck && pnpm test:unit && pnpm test:smoke"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
