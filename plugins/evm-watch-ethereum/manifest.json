        "control": "textarea",
        "required": true
      }
    ],
    "previewScope": "ETH、ERC-20（公开地址只读）"
  },
  "configuration": [
    "rpc.ethereum",
    "coingecko.apiKey"
  ],
  "metadata": {
    "summary": "ETH、ERC-20（公开地址只读）",
    "publisher": "KanBan",
    "homepage": "https://github.com/chiperman/KanBan"
  }
}
