{
  "id": "evm-watch-ethereum",
  "version": "1.0.0",
  "protocolVersion": 1,
  "capabilities": [
    "assets.read",
    "authorization.preview",
    "authorization.revalidate",
    "extension.call"
  ],
  "entry": "plugins/evm-watch-ethereum/src/main.mjs",
  "description": {
    "label": "Ethereum 观察钱包",
